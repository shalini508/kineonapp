# Copy to .env and fill in, or export these before running the scripts.
# Nothing here is committed -- .env is gitignored.

# Supabase project the QA/load-test scripts run against.
# Both values are in the Supabase dashboard under Project Settings > API.
# Use the legacy JWT anon key (role=anon), not the service_role key --
# no script here needs service_role, and it must never be put in this repo.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Seeded QA account used by the Appium smoke/retest scripts.
TEST_EMAIL=<qa-account-email>
TEST_PASSWORD=<qa-account-password>

# Optional overrides
# USERS_CSV=data/users_15thsep.csv   # pre-minted load-test tokens
# APPIUM_PORT=4723                   # point at a different Appium server
